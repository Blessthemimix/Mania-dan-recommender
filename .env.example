# Copy this file to .env and fill it in. Never commit .env.

# Discord Developer Portal -> your application -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> your application -> General Information -> Application ID
DISCORD_APP_ID=
# Optional: a server ID. If set, slash commands register to that server instantly
# (good for testing). If empty, they register globally (can take up to an hour).
DISCORD_GUILD_ID=

# Optional, but required for automatic Dan tracking (the /link command and the
# background sync). Create a Legacy API key at
# https://osu.ppy.sh/home/account/edit -> Legacy API.
OSU_API_KEY=
